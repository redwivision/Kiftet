# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
#
# ⚠️ PLACEHOLDER — local development default only.
# NEVER rely on this in production. Set the real value on your
# hosting platform as the VITE_SERVER_URL env var; it overrides this
# default at build time and in runtime auto-load.
# Server ROOT (no /api suffix) — the web app appends /api itself.
VITE_SERVER_URL=http://localhost:3000

# @public @type=string @required=false
#
# Set your Voxide publishable key from voxide.app/dashboard → Integration.
# Leave empty to disable Voxide (Web Speech fallback activates instead).
VITE_VOXIDE_KEY=

# @public @type=url @required=false
#
# Public origin of THIS web app (e.g. https://app.kiftet.com), used only to
# make og:image / twitter:image absolute so social previews render. Leave
# empty in dev — relative paths are fine locally. In production, set it on
# your hosting platform at build time so shares and previews carry the logo.
VITE_SITE_URL=
