# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
#
# ⚠️ PLACEHOLDER — local development default only (never a real secret).
# Set a strong, unique secret on your hosting platform via BETTER_AUTH_SECRET.
# The placeholder only exists so production builds pass without .env files.
BETTER_AUTH_SECRET=dev-only-placeholder-change-me-0123456789abcdef

# @public @dynamic @type=url
#
# ⚠️ PLACEHOLDER — local development default. Set the real public URL
# (e.g. https://your-app.example) via BETTER_AUTH_URL on your platform.
BETTER_AUTH_URL=http://localhost:3000

# @public @dynamic @type=url
#
# ⚠️ PLACEHOLDER — local development default. Set the real web origin
# (e.g. https://your-web-frontend.example) via CORS_ORIGIN on your platform.
CORS_ORIGIN=http://localhost:3000

# @type=boolean
#
# Refuse to sign in an account whose address has not been confirmed. Only turn
# this on once AUTH_EMAIL_TRANSPORT delivers real mail: with "console" the
# confirmation link is printed to the server log and never reaches the user, so
# requiring verification would lock out every real signup with no way back in.
REQUIRE_EMAIL_VERIFICATION=false

# @optional
# @type=string(minLength=1)
#
# Google sign-in. Set BOTH the id and the secret, or the provider is treated as
# not configured and its button never appears. Create them in Google Cloud
# Console under APIs & Services > Credentials, with the redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google. Free, no usage cap.
GOOGLE_CLIENT_ID=

# @optional
# @type=string
#
# The secret half of the Google pair above.
GOOGLE_CLIENT_SECRET=

# @optional
# @type=string(minLength=1)
#
# Facebook sign-in — the widest-reach account in Ethiopia (9.8M, per Meta's own
# figures, against 29.5M internet users nationwide), so this is the button that
# matters most here. Create the app in the Meta developer portal with the
# Facebook Login product, and set the redirect URI to
# <BETTER_AUTH_URL>/api/auth/callback/facebook. Free, no usage cap.
FACEBOOK_CLIENT_ID=

# @optional
# @type=string
#
# The secret half of the Facebook pair above.
FACEBOOK_CLIENT_SECRET=

# @optional
# @type=string(minLength=1)
#
# GitHub sign-in. Set BOTH the id and secret to show its social sign-in button.
# Useful when Google rejects the deployment domain; callback:
# <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=

# @optional
# @type=string
#
# GitHub client secret.
GITHUB_CLIENT_SECRET=

# @type=enum(console)
#
# Where confirmation and password-reset mail goes. "console" prints the link to
# the server log instead of sending it, so the whole flow works end to end in
# development — but nobody receives anything, so it must not be the value
# running in production. The enum has no other member on purpose: picking a
# real provider has to mean writing the transport, not just changing a string.
AUTH_EMAIL_TRANSPORT=console

# @type=string(minLength=1)
#
# ⚠️ PLACEHOLDER — local development default only.
# Set the real Postgres connection string via DATABASE_URL on your platform.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiftet

# @type=string(minLength=1)
#
# ⚠️ PLACEHOLDER — local development default only.
# The UNPOOLED peer of DATABASE_URL, used for schema migrations at boot.
# On Neon this is the string whose hostname has no "-pooler" suffix.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/kiftet

# @type=string(minLength=1)
#
# ⚠️ PLACEHOLDER — the prototype branch runs on SQLite, not Postgres.
# Path to the local SQLite file used by this app.
DATABASE_FILE=./kiftet-dev.db

# @type=string(minLength=1) @sensitive
#
# ⚠️ PLACEHOLDER — the prototype uses Google Gemini as the primary LLM
# provider. Set your real Gemini API key via GEMINI_API_KEY on your platform.
GEMINI_API_KEY=placeholder-gemini-api-key

# @type=string(minLength=1) @sensitive
#
# ⚠️ PLACEHOLDER — Groq is the failover provider. When Gemini is exhausted
# (its free-tier quota is a hard 20-ish calls/day — see AI_CIRCUIT_FAILURES),
# fails, or is unconfigured, the retry ladder answers the same request with
# Groq before it ever degrades to the deterministic fallback. Set your real
# key via GROQ_API_KEY on your platform. Leave the placeholder and the seam
# keeps working exactly as it did before this provider existed.
GROQ_API_KEY=placeholder-groq-api-key

# ─── AI admission control (the shared-quota ceiling) ──────────────────
# The free tiers are per *project*, not per user, so N students do not get N
# times the allowance — they share one. Gemini and Groq draw on two separate
# quotas, so each has its OWN bucket and circuit breaker: when Gemini is
# exhausted the breaker opens for Gemini alone and the ladder skips straight
# to Groq at Groq's full rate. Only when BOTH shed does a student get the
# honest "busy" answer. The two numbers below are the only knobs that decide
# how fast either quota drains. Read at boot; see
# apps/server/src/ai/admission.ts for what each one gates.

# @optional @type=number
#
# Gemini calls allowed per minute across ALL users, process-wide. 5 is the
# free tier's per-minute ceiling for gemini-2.5-flash — the number below it
# on purpose, because an allowance above the provider's does not buy capacity,
# it just manufactures 429s that cost a full retry budget each.
AI_GEMINI_PER_MINUTE=5

# @optional @type=number
#
# Groq calls allowed per minute across ALL users, process-wide. The free tier
# for the configured Groq model (openai/gpt-oss-120b — see GROQ_MODELS) is
# ~30 req/min; 20 sits below it for the same reason the Gemini number does —
# an allowance above the provider's ceiling does not buy capacity, it
# manufactures 429s.
AI_GROQ_PER_MINUTE=20

# @optional @type=number
#
# How many admitted calls may be in flight at once. Bounds memory and stops
# the retry ladder multiplying load precisely when the provider is struggling.
# Shared across providers, not one pool each: a real student request occupies
# one slot whether it ends up answered by Gemini or by Groq.
AI_MAX_CONCURRENT=4

# @optional @type=number
#
# Consecutive transient provider failures before THAT provider's breaker opens
# and the ladder stops trying it. Per-provider on purpose: a storm of Gemini
# quota refusals must open Gemini's breaker without also taking Groq offline.
# Only retryable failures count — a 400 is the request's fault, not the
# provider's, and must not penalise other students.
AI_CIRCUIT_FAILURES=6

# @optional @type=number
#
# How long a provider's breaker stays open (ms) before letting one probe call
# through. During the cooldown the ladder skips that provider entirely and
# every student gets an honest "busy, try in N seconds" (or Groq, when a
# second provider is configured) instead of a 24s hang per request — which is
# how a provider blip used to become a total site outage.
AI_CIRCUIT_COOLDOWN_MS=30000

# @optional @type=number
#
# How long a request may wait for a concurrency slot (ms) before being shed.
# Kept under the 24s client window so a shed is still a fast, honest answer.
AI_ADMISSION_WAIT_MS=8000

# ─── Demo ─────────────────────────────────────────────────────────────
# /demo/start writes a user, a textbook, a chapter and ten concept rows. The
# per-IP limit (2/min) stops one script; this GLOBAL limit is what stops a
# viral link, because a shared link is a thousand distinct IPs arriving at once
# and a per-IP cap would let every one of them take its full allowance.
#
# Sized so demo seeding can never crowd out a real student's session write. It
# sheds with 503 rather than queueing — a queued demo request is a real student
# waiting behind it. Lower this first if demo growth is a problem; 25/min is
# ~390 junk rows/min, ~19k/day.

# @optional @type=number
DEMO_STARTS_PER_MINUTE=25

# ─── Waitlist ─────────────────────────────────────────────────────────
# The waitlist is the one endpoint that must not be shed under any load, so it
# gets its own small pool (two connections) rather than sharing the five the
# study loop uses. It deliberately stays on the POOLED connection, not
# DATABASE_URL_DIRECT: a signup is one short indexed write, which is exactly
# what a pooler is for, and the direct endpoint is reserved for migrations.

# @optional @type=number
#
# Signups allowed per hour from one IP. Shared-NAT (a school, a carrier CGNAT)
# means many real students share an address, so this is set for abuse rather
# than for fairness — per-phone limiting carries the real weight. Kept at 60 to
# match the route's own fallback: a lecture hall signing up together is the case
# this number must not break, and 20 was low enough to lock one out.
WAITLIST_PER_IP_PER_HOUR=60

# @optional @type=number
#
# Hard cap on the waitlist. Past this the endpoint returns a closed state
# (HTTP 200, no error) so a full waitlist never presents as a broken page.
WAITLIST_MAX_SIGNUPS=20000

# @optional @type=number
#
# How many signups make up one wave. Waves are the launch-staging unit: wave 1
# is invited first, then 2, so launch-day load arrives in steps instead of one
# spike. Kept well above the expected signup count so a quiet launch still
# produces more than one wave — otherwise the idea does no work.
WAITLIST_WAVE_SIZE=250

# @optional @type=string
#
# Telegram username of the launch bot (no @). Powers the one-tap deep link a
# student gets after signing up, which is how a signup becomes a *verified*
# channel member. Leave unset and the form still works; activation is simply
# unavailable until it is set.
TELEGRAM_BOT_USERNAME=

# @optional @type=string @sensitive
#
# Bot token from @BotFather. Only needed once the webhook route is live.
# Empty means the Telegram routes 404 rather than failing at boot, so a
# half-configured deployment still serves the waitlist.
TELEGRAM_BOT_TOKEN=

# @optional @type=string @sensitive
#
# Secret Telegram echoes back as X-Telegram-Bot-Api-Secret-Token on every
# webhook delivery. This is the webhook's entire authentication — it must match
# or the route rejects the call. Should be its own random value, not the token.
TELEGRAM_WEBHOOK_SECRET=

# @optional @type=url
#
# Public link to the Telegram group (https://t.me/<Name>). The group is how
# launch is announced — a waitlist with a date on the landing page gets a slipped
# date, whereas one announcement message reaches everyone at once.
#
# Must be the public `t.me/<Name>` form. A private invite link (t.me/+… or
# /joinchat/…) carries no username, and membership verification needs something
# to check the student's join against.
TELEGRAM_CHANNEL_URL=

# @optional
#
# Numeric id of that group, e.g. -1004366253026. Same value `getChat` returns.
#
# This is the identifier that keeps working if the group is ever switched to
# private, because the username stops resolving for anyone not already inside
# it. Optional: when unset, membership checks match on the username that
# Telegram attaches to each message anyway. Cheap to set now while the id is
# known, and impossible to recover later without an update to scrape.
TELEGRAM_CHANNEL_ID=

# @optional
#
# Where `telegram:testimonials` sends the one-line testimonials students write to
# the bot. Your own Telegram chat id: message @userinfobot to read it, or take it
# from a waitlist row you activated (waitlist_signup.telegram_chat_id). A private
# chat id is a positive number; a group's is negative. Leave unset and the script
# still runs with `--to=<chat id>` for a single invocation.
TELEGRAM_ADMIN_CHAT_ID=
