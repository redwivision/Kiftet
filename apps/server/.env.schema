# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
#
# ⚠️ PLACEHOLDER — local development default only (never a real secret).
# Set a strong, unique secret on your hosting platform via BETTER_AUTH_SECRET.
# The placeholder only exists so production builds pass without .env files.
BETTER_AUTH_SECRET=dev-only-placeholder-change-me-0123456789abcdef

# @public @dynamic @type=url
#
# ⚠️ PLACEHOLDER — local development default. Set the real public URL
# (e.g. https://your-app.example) via BETTER_AUTH_URL on your platform.
BETTER_AUTH_URL=http://localhost:3000

# @public @dynamic @type=url
#
# ⚠️ PLACEHOLDER — local development default. Set the real web origin
# (e.g. https://your-web-frontend.example) via CORS_ORIGIN on your platform.
CORS_ORIGIN=http://localhost:3000

# @type=boolean
#
# Refuse to sign in an account whose address has not been confirmed. Only turn
# this on once AUTH_EMAIL_TRANSPORT delivers real mail: with "console" the
# confirmation link is printed to the server log and never reaches the user, so
# requiring verification would lock out every real signup with no way back in.
REQUIRE_EMAIL_VERIFICATION=false

# @type=enum(console)
#
# Where confirmation and password-reset mail goes. "console" prints the link to
# the server log instead of sending it, so the whole flow works end to end in
# development — but nobody receives anything, so it must not be the value
# running in production. The enum has no other member on purpose: picking a
# real provider has to mean writing the transport, not just changing a string.
AUTH_EMAIL_TRANSPORT=console

# @type=string(minLength=1)
#
# ⚠️ PLACEHOLDER — local development default only.
# Set the real Postgres connection string via DATABASE_URL on your platform.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiftet

# @type=string(minLength=1)
#
# ⚠️ PLACEHOLDER — local development default only.
# The UNPOOLED peer of DATABASE_URL, used for schema migrations at boot.
# On Neon this is the string whose hostname has no "-pooler" suffix.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/kiftet

# @type=string(minLength=1)
#
# ⚠️ PLACEHOLDER — the prototype branch runs on SQLite, not Postgres.
# Path to the local SQLite file used by this app.
DATABASE_FILE=./kiftet-dev.db

# @type=string(minLength=1) @sensitive
#
# ⚠️ PLACEHOLDER — the prototype uses Google Gemini as the LLM provider.
# Set your real Gemini API key via GEMINI_API_KEY on your platform.
GEMINI_API_KEY=placeholder-gemini-api-key
